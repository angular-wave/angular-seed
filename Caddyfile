{
	auto_https off
	admin off
}

:{$PORT:4000} {
	root * dist

	route {
		handle /sse {
			reverse_proxy 127.0.0.1:{$LIVE_RELOAD_PORT:35729}
		}

		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		@static_asset path_regexp static_asset (?i)\.(?:js|mjs|css|map|json|svg|png|jpe?g|gif|webp|ico|woff2?|ttf|eot|wasm)$
		handle @static_asset {
			file_server
		}

		try_files {path} {path}/ /index.html
		file_server
	}
}
